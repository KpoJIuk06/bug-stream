# ============================================================
#  Bug Stream — installation settings for your organization
#  Copy to .env and fill in. .env never goes to git.
# ============================================================

# --- Address ---
# The subdomain you were given (no https://, no trailing slash)
APP_DOMAIN=bugs.example.com

# How https works:
#   proxy — https ends on the corporate load balancer / proxy, which forwards plain HTTP to HTTP_PORT
#   nginx — put the certificate into certs/, the container serves https itself (port HTTPS_PORT)
TLS_MODE=proxy
# File names in certs/ (for TLS_MODE=nginx)
TLS_CERT=fullchain.pem
TLS_KEY=privkey.pem
HTTP_PORT=80
HTTPS_PORT=443

# Address used in e-mails, Jira issues and share links. Default: https://${APP_DOMAIN}
# APP_PUBLIC_URL=https://bugs.example.com
# Where API calls may come from. Default: https://${APP_DOMAIN},chrome-extension://*
# After packing the extension you can narrow it to its ID (printed by extension/scripts/pack-extension.ps1):
# CORS_ORIGINS=https://bugs.example.com,chrome-extension://abcdefghijklmnopabcdefghijklmnop

# --- Nexus (empty = download from the internet) ---
# Nexus Docker registry with a trailing slash: nexus.example.com:8083/
DOCKER_REGISTRY=
# Nexus Maven group (mirror of Maven Central)
MAVEN_MIRROR_URL=
# Nexus npm group (mirror of registry.npmjs.org)
NPM_REGISTRY=

# --- Database ---
POSTGRES_DB=bugstream
POSTGRES_USER=bugstream
# openssl rand -base64 24
POSTGRES_PASSWORD=change_me

# --- Backend ---
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=change_me_change_me_change_me_change_me
# First administrator (local account, created only while there are no users). Change the password after signing in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=Administrator
# Encryption key for saved secrets: Jira / Slack tokens, SMTP and LDAP passwords (empty = JWT_SECRET is used).
# Do not change it later: the saved secrets would have to be entered again.
INTEGRATION_SECRET=

# Where videos and screenshots are stored on the server
STORAGE_DIR=./storage
TZ=UTC

# Extra JVM options, e.g. an outgoing proxy to reach Jira Cloud:
# JAVA_OPTS=-Dhttps.proxyHost=proxy.example.com -Dhttps.proxyPort=3128 -Dhttp.nonProxyHosts=*.example.com|localhost
JAVA_OPTS=

# How often Jira issue statuses are refreshed (ISO-8601 duration, default 5 minutes)
# JIRA_STATUS_SYNC=PT5M

# --- Sign-in with Active Directory / LDAP (optional) ---
# Usually set in Administration → Sign-in methods; values here are only used until it is saved there.
# LDAP_URL empty = no directory.
# ldaps://dc1.example.com:636 (several servers separated by spaces). For an internal CA put its
# certificate (*.crt / *.pem) into certs/ca/ — it is trusted automatically.
LDAP_URL=
LDAP_BASE_DN=DC=example,DC=com
# Read-only service account that searches users
LDAP_BIND_DN=CN=svc-bugstream,OU=Service Accounts,DC=example,DC=com
LDAP_BIND_PASSWORD=
# {0} = what the user typed. Empty = sAMAccountName, userPrincipalName or mail (Active Directory)
LDAP_USER_FILTER=
# Role from AD groups, checked on every sign-in; the first match wins. Empty = roles are managed in the admin panel.
# LDAP_GROUP_ROLES=CN=BugStream-Admins,OU=Groups,DC=example,DC=com=ADMIN;CN=BugStream-QA,OU=Groups,DC=example,DC=com=TESTER
LDAP_GROUP_ROLES=
# Role of a new LDAP user when LDAP_GROUP_ROLES is empty
LDAP_DEFAULT_ROLE=DEVELOPER

# --- E-mail (optional) ---
# Usually set in Administration → E-mail (SMTP); values here are only used until it is saved there.
# Needed for sign-in codes, password reset and invitation links, and notifications. SMTP_HOST empty = no e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=bugstream@example.com
# 587 -> STARTTLS=true, SSL=false;  465 -> STARTTLS=false, SSL=true
SMTP_STARTTLS=true
SMTP_SSL=false
